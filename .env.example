# ==========================================================
#  Firebase — Client (آمن للعرض في المتصفح)
#  Firebase Console → Project Settings → Your apps → SDK setup
# ==========================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==========================================================
#  Firebase — Server (سرّي — لا يظهر في المتصفح أبدًا)
#  Firebase Console → Service accounts → Generate new private key
#  ضع محتوى الملف كاملاً كسلسلة JSON في سطر واحد
# ==========================================================
FIREBASE_SERVICE_ACCOUNT_JSON=

# ==========================================================
#  Groq API
#  https://console.groq.com/keys
# ==========================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================================
#  App
#  رابط الموقع النهائي (لإنشاء روابط الامتحانات المشتركة)
# ==========================================================
NEXT_PUBLIC_SITE_URL=

# ==========================================================
#  وضع تجريبي (اختياري)
#  1 = تشغيل بدون Firebase/Groq (بيانات مؤقتة + بنك الأسئلة المحلي)
#  0 = إيقاف الوضع التجريبي إجباريًا
#  فارغ = تلقائي (تجريبي إذا لا يوجد FIREBASE_SERVICE_ACCOUNT_JSON)
# ==========================================================
DEMO_MODE=
